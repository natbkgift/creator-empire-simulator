# Persistent provider credentials are read only by creator_server.py.
# Never commit real values. Copy this file to .env only if your launcher loads env files,
# or set these variables through the operating system / shell before starting the app.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Google OAuth Web Client for private YouTube uploads. An AI Studio API key cannot replace these values.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://creator.flowbiz.cloud/api/youtube/oauth/callback

# URL-safe Fernet key used to encrypt OAuth refresh tokens and resumable session URIs at rest.
# Generate securely on the server and never print or commit its real value.
CREATOR_EMPIRE_TOKEN_KEY=

# Optional temporary MP4 storage. Assets expire after 24 hours.
# CREATOR_EMPIRE_UPLOAD_DIR=/var/lib/creator-empire/uploads
# CREATOR_EMPIRE_MAX_VIDEO_BYTES=2147483648

# Optional: relocate the local SQLite database outside the repository.
# CREATOR_EMPIRE_DB=/absolute/path/to/creator_empire.sqlite

# Remote binding is blocked unless explicitly enabled. Keep this unset for normal desktop use.
# CREATOR_EMPIRE_ALLOW_REMOTE=0
