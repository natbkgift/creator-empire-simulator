# Persistent provider credentials are read only by creator_server.py.
# Never commit real values. Copy this file to .env only if your launcher loads env files,
# or set these variables through the operating system / shell before starting the app.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: relocate the local SQLite database outside the repository.
# CREATOR_EMPIRE_DB=/absolute/path/to/creator_empire.sqlite

# Remote binding is blocked unless explicitly enabled. Keep this unset for normal desktop use.
# CREATOR_EMPIRE_ALLOW_REMOTE=0
